# Copy to .env. Variables already set in the environment win over this file.

# --- Local model through Ollama (default) -----------------------------------
HARNESS_BACKEND=ollama
HARNESS_MODEL=qwen2.5:7b-instruct
# 0 = every layer on the CPU. Keep it 0 while a training job owns the GPU;
# set 99 to put the whole model on a free GPU.
HARNESS_NUM_GPU=0
HARNESS_NUM_THREAD=6
# Ollama's context window. Also the harness's compaction limit unless
# HARNESS_CONTEXT_LIMIT is set.
HARNESS_NUM_CTX=8192
HARNESS_KEEP_ALIVE=30m

# --- Hosted model through any OpenAI-compatible API --------------------------
# HARNESS_BACKEND=openai
# HARNESS_BASE_URL=https://openrouter.ai/api/v1
# HARNESS_API_KEY=sk-or-...
# HARNESS_MODEL=deepseek/deepseek-v4-flash   (check the exact id on openrouter.ai/models)

# --- Optional ----------------------------------------------------------------
# HARNESS_OUTPUT_CAP=3000        characters of one tool result the model sees
# HARNESS_MAX_STEPS=40           model calls per user turn
# HARNESS_SANDBOX=auto           auto | none | required
# HARNESS_SHELL=                 force a shell, e.g. C:\Program Files\Git\bin\bash.exe
# HARNESS_SKILLS_DIRS=           replaces the default skill folders (os.pathsep-separated)
